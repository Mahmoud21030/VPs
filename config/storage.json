{
  "default_provider": "backblaze",
  "remote_prefix": "windows-vm",
  "base_object": "base.qcow2",
  "latest_object": "latest/overlay.qcow2.zst",
  "latest_sha256_object": "latest/overlay.sha256",
  "manifest_object": "latest/manifest.json",
  "checkpoint_prefix": "checkpoints",
  "rotation_count": 0,
  "providers": {
    "backblaze": {
      "bucket_env": "B2_BUCKET",
      "endpoint_env": "B2_ENDPOINT",
      "access_key_env": "B2_KEY_ID",
      "secret_key_env": "B2_APPLICATION_KEY",
      "region_env": "B2_REGION",
      "default_region": "us-east-1"
    },
    "oracle": {
      "bucket_env": "ORACLE_BUCKET",
      "endpoint_env": "ORACLE_ENDPOINT",
      "access_key_env": "ORACLE_ACCESS_KEY_ID",
      "secret_key_env": "ORACLE_SECRET_ACCESS_KEY",
      "region_env": "ORACLE_REGION",
      "namespace_env": "ORACLE_NAMESPACE"
    }
  }
}
