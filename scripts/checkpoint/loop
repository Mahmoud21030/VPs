#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/../common.sh"

interval="$(jq -r '.interval_minutes // 15' "$ROOT_DIR/config/checkpoint.json")"
stop_file="$WORK_DIR/checkpoint-loop.stop"
pid_file="$WORK_DIR/checkpoint-loop.pid"

if [[ ! "$interval" =~ ^[0-9]+$ ]] || (( interval < 1 )); then
  log "invalid checkpoint interval: $interval"
  exit 1
fi

rm -f "$stop_file"
printf '%s\n' "$$" > "$pid_file"
trap 'rm -f "$pid_file"; log "automatic checkpoint loop stopped"' EXIT

log "automatic checkpoint loop started: every ${interval} minute(s)"

while true; do
  log "next automatic checkpoint in ${interval} minute(s)"

  remaining=$((interval * 60))
  while (( remaining > 0 )); do
    if [[ -e "$stop_file" ]]; then
      exit 0
    fi
    sleep_for=5
    if (( remaining < sleep_for )); then
      sleep_for="$remaining"
    fi
    sleep "$sleep_for"
    remaining=$((remaining - sleep_for))
  done

  if [[ -e "$stop_file" ]]; then
    exit 0
  fi

  log "automatic checkpoint starting"

  if "$ROOT_DIR/scripts/checkpoint/checkpoint" latest; then
    log "automatic checkpoint completed successfully"
  else
    status=$?
    log "automatic checkpoint failed with exit code $status; loop will continue"
  fi

  if [[ -e "$stop_file" ]]; then
    exit 0
  fi
done
