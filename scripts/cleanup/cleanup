#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/../common.sh"

log "cleanup started"

"$ROOT_DIR/scripts/checkpoint/stop-loop"

if [[ -f "$WORK_DIR/final-checkpoint.done" ]]; then
    log "verified final latest checkpoint was already completed"
    if [[ -f "$WORK_DIR/qemu.pid" ]]; then
        QEMU_PID="$(cat "$WORK_DIR/qemu.pid")"
        if kill -0 "$QEMU_PID" 2>/dev/null; then
            "$ROOT_DIR/scripts/qemu/shutdown"
        fi
    fi
    exit 0
fi

OVERLAY_PATH="$ROOT_DIR/$(jq -r '.overlay_image' "$ROOT_DIR/config/vm.json")"

if [[ ! -f "$OVERLAY_PATH" ]]; then
    log "no overlay exists; nothing to save"
    exit 0
fi

log "starting final latest checkpoint"
python3 "$ROOT_DIR/scripts/libvm.py" checkpoint --name latest
touch "$WORK_DIR/final-checkpoint.done"
log "final latest checkpoint completed successfully"

if [[ -f "$WORK_DIR/qemu.pid" ]]; then
    QEMU_PID="$(cat "$WORK_DIR/qemu.pid")"
    if kill -0 "$QEMU_PID" 2>/dev/null; then
        "$ROOT_DIR/scripts/qemu/shutdown"
    fi
fi
