#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/../common.sh"

forced_minutes="$(jq -r '.forced_save_after_minutes // 300' "$ROOT_DIR/config/checkpoint.json")"
if [[ ! "$forced_minutes" =~ ^[0-9]+$ ]] || (( forced_minutes < 1 )); then
  echo "invalid forced_save_after_minutes: $forced_minutes" >&2
  exit 1
fi

start_epoch="${WORKFLOW_START_EPOCH:-$(date +%s)}"
if [[ ! "$start_epoch" =~ ^[0-9]+$ ]]; then
  echo "invalid WORKFLOW_START_EPOCH: $start_epoch" >&2
  exit 1
fi

deadline=$((start_epoch + forced_minutes * 60))
log "runtime supervisor started; forced final save deadline=$(date -u -d "@$deadline" +%Y-%m-%dT%H:%M:%SZ)"

while true; do
  if ! qemu_is_running; then
    log "QEMU exited after normal Windows shutdown"
    "$ROOT_DIR/scripts/checkpoint/stop-loop"
    "$ROOT_DIR/scripts/checkpoint/checkpoint" latest
    touch "$WORK_DIR/final-checkpoint.done"
    log "final latest checkpoint completed successfully"
    exit 0
  fi

  loop_pid="$(cat "$WORK_DIR/checkpoint-loop.pid" 2>/dev/null || true)"
  if ! pid_matches_command "$loop_pid" "scripts/checkpoint/loop"; then
    echo "automatic checkpoint loop exited unexpectedly" >&2
    if [[ "$loop_pid" =~ ^[0-9]+$ && -r "/proc/$loop_pid/cmdline" ]]; then
      printf 'checkpoint loop PID %s command: ' "$loop_pid" >&2
      tr '\0' ' ' < "/proc/$loop_pid/cmdline" >&2
      printf '\n' >&2
    else
      echo "checkpoint loop PID file was missing, invalid, or stale: ${loop_pid:-<empty>}" >&2
    fi
    exit 1
  fi

  now="$(date +%s)"
  if (( now >= deadline )); then
    log "forced-save deadline reached after ${forced_minutes} minute(s)"
    "$ROOT_DIR/scripts/checkpoint/stop-loop"
    "$ROOT_DIR/scripts/checkpoint/checkpoint" latest
    touch "$WORK_DIR/final-checkpoint.done"
    log "forced final latest checkpoint completed successfully"
    "$ROOT_DIR/scripts/qemu/shutdown"
    log "QEMU shut down after verified forced final checkpoint"
    exit 0
  fi

  sleep 10
done
